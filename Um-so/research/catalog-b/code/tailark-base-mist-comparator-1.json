al\"\n                                    />\n                                </th>\n                                <th className=\"space-y-3\">\n                                    <span className=\"block\">Pro</span>\n                                    <Button\n                                        nativeButton={false}\n                                        render={<Link href=\"#\">Get Started</Link>}\n                                        variant=\"neutral\"\n                                    />\n                                </th>\n                                <th className=\"space-y-3\">\n                                    <span className=\"block\">Startup</span>\n                                    <Button\n                                        nativeButton={false}\n                                        render={<Link href=\"#\">Get Started</Link>}\n                                        variant=\"neutral\"\n                                    >\n                                        <Link href=\"#\">Get Started</Link>\n                                    </Button>\n                                </th>\n                            </tr>\n                        </thead>\n                        <tbody>\n                            <tr className=\"*:py-4\">\n                                <td className=\"flex items-center gap-2 font-medium\">\n                                    <Star className=\"size-4\" />\n                                    <span>Features</span>\n                                </td>\n                                <td></td>\n                                <td className=\"border-none px-4\"></td>\n                                <td></td>\n                            </tr>\n                            {tableData.slice(-4).map((row, index) => (\n                                <tr\n                                    key={index}\n                                    className=\"*:border-b *:py-4\"\n                                >\n                                    <td className=\"text-muted-foreground\">{row.feature}</td>\n                                    <td>\n                                        {row.free === true ? (\n                                            <Check\n                                                className=\"text-primary size-3\"\n                                                strokeWidth={3.5}\n                                            />\n                                        ) : (\n                                            row.free\n                                        )}\n                                    </td>\n                                    <td>\n                                        {row.pro === true ? (\n                                            <Check\n                                                className=\"text-primary size-3\"\n                                                strokeWidth={3.5}\n                                            />\n                                        ) : (\n                                            row.pro\n                                        )}\n                                    </td>\n                                    <td>\n                                        {row.startup === true ? (\n                                            <Check\n                                                className=\"text-primary size-3\"\n                                                strokeWidth={3.5}\n                                            />\n                                        ) : (\n                                            row.startup\n                                        )}\n                                    </td>\n                                </tr>\n                            ))}\n                            <tr className=\"*:pb-4 *:pt-8\">\n                                <td className=\"flex items-center gap-2 font-medium\">\n                                    <Sparkles className=\"size-4\" />\n                                    <span>AI Models</span>\n                                </td>\n                                <td></td>\n                                <td className=\"bg-muted border-none px-4\"></td>\n                                <td></td>\n                            </tr>\n                            {tableData.map((row, index) => (\n                                <tr\n                                    key={index}\n                                    className=\"*:border-b *:py-4\"\n                                >\n                                    <td className=\"text-muted-foreground\">{row.feature}</td>\n                                    <td>\n                                        {row.free === true ? (\n                                            <Check\n                                                className=\"text-primary size-3\"\n                                                strokeWidth={3.5}\n                                            />\n                                        ) : (\n                                            row.free\n                                        )}\n                                    </td>\n                                    <td>\n                                        {row.pro === true ? (\n                                            <Check\n                                                className=\"text-primary size-3\"\n                                                strokeWidth={3.5}\n                                            />\n                                        ) : (\n                                            row.pro\n                                        )}\n                                    </td>\n                                    <td>\n                                        {row.startup === true ? (\n                                            <Check\n                                                className=\"text-primary size-3\"\n                                                strokeWidth={3.5}\n                                            />\n                                        ) : (\n                                            row.startup\n                                        )}\n                                    </td>\n                                </tr>\n                            ))}\n                        </tbody>\n                    </table>\n                </div>\n            </div>\n        </section>\n    )\n}\n",
