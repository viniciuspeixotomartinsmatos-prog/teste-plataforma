-1721-40ff-8137-7edd17f1ef6f.png","videoUrl":"https://cdn.21st.dev/arihantcodes_1f7b8c4d/beam-search/default/video.1790144967364-79ce3a64-1721-40ff-8137-7edd17f1ef6f.mp4","author":"arihantcodes_1f7b8c4d","authorImage":"https://img.clerk.com/eyJ0eXBlIjoicHJveHkiLCJzcmMiOiJodHRwczovL2ltYWdlcy5jbGVyay5kZXYvb2F1dGhfZ2l0aHViL2ltZ18yeG1JVU5OMFdtUE1yYWxOWW12VzdUVHY5ZmUifQ","installCommand":"npx shadcn@latest add \"https://21st.dev/r/arihantcodes_1f7b8c4d/beam-search?api_key=$API_KEY_21ST\"","url":"https://21st.dev/@arihantcodes_1f7b8c4d/components/beam-search"},{"type":"component","id":39754,"name":"BJORK Scatter brush","description":"Scatter brush is a production-ready charts component from BJORK UI, packaged for shadcn registries.","previewUrl":"https://cdn.21st.dev/user_2tkbBPFWYn8YMjZNHwgIuP3yzvd/bjork-scatter-brush/default/preview.1792496620318.webp","videoUrl":"https://cdn.21st.dev/user_2tkbBPFWYn8YMjZNHwgIuP3yzvd/bjork-scatter-brush/default/video.1792496615185.mp4","author":"isaiahbjork","authorImage":"https://img.clerk.com/eyJ0eXBlIjoicHJveHkiLCJzcmMiOiJodHRwczovL2ltYWdlcy5jbGVyay5kZXYvb2F1dGhfZ2l0aHViL2ltZ18ydGtiQlBjalhzMzl1eGNmR2h3c3VTWE1VU1YifQ","installCommand":"npx shadcn@latest add \"https://21st.dev/r/isaiahbjork/bjork-scatter-brush?api_key=$API_KEY_21ST\"","url":"https://21st.dev/@isaiahbjork/components/bjork-scatter-brush"},{"type":"component","id":33521,"name":"Orbit Sweep","description":"Pure CSS gradient background in the Orbit Sweep style, made with the 21st.dev Gradient Builder. 3-color palette (#2B0A3D, #7B4BA8, #E6D6F5). Features: film grain, vignette. A drop-in, zero-dependency React component for hero sections, cards, and page backgrounds.","previewUrl":"https://cdn.21st.dev/abushaidislam7/orbit-sweep/default/preview.1790679332617-ec20db29-8789-445b-858c-14e0bfba403f.webp","videoUrl":null,"author":"abushaidislam7","authorImage":"https://img.clerk.com/eyJ0eXBlIjoicHJveHkiLCJzcmMiOiJodHRwczovL2ltYWdlcy5jbGVyay5kZXYvb2F1dGhfZ29vZ2xlL2ltZ18yemJyc05aelk1S1JieGhOMlJUcHZWU2JsVEQifQ","installCommand":"npx shadcn@latest add \"https://21st.dev/r/abushaidislam7/orbit-sweep?api_key=$API_KEY_21ST\"","url":"https://21st.dev/@abushaidislam7/components/orbit-sweep"},{"type":"component","id":39941,"name":"Sweepsy","description":"Animated (flicker) ASCII art in the Dither style, made with the 21st ASCII editor and baked to a looping video. A drop-in, zero-dependency React component for hero sections, cards, and retro terminal-style backgrounds.","previewUrl":"https://cdn.21st.dev/timbrdnik/sweepsy/default/preview.1792498848095-5e2cbd1b-bd99-40af-a966-11ef60f3de08.webp","videoUrl":"https://cdn.21st.dev/timbrdnik/sweepsy/default/video.1792498848095-5e2cbd1b-bd99-40af-a966-11ef60f3de08.mp4","author":"timbrdnik","authorImage":"https://img.clerk.com/eyJ0eXBlIjoicHJveHkiLCJzcmMiOiJodHRwczovL2ltYWdlcy5jbGVyay5kZXYvb2F1dGhfZ29vZ2xlL2ltZ18zQ3dCZlhZdlBBdHloYkJtcVN4OVd5U3BhY1kifQ","installCommand":"npx shadcn@latest add \"https://21st.dev/r/timbrdnik/sweepsy?api_key=$API_KEY_21ST\"","url":"https://21st.dev/@timbrdnik/components/sweepsy"},{"type":"component","id":29384,"name":"Filmstrip Scrub","description":"A horizontal filmstrip scrubber with a spring-loaded playhead — drag or hover the strip to crossfade a large preview between stills, with frame ticks, a live monospace timecode, and idle auto-scrubbing.","previewUrl":"https://cdn.21st.dev/rmahammad/filmstrip-scrub/default/preview.1790072120543-2563d96d-37c9-4216-98b8-e9d6eb6d17c1.png","videoUrl":"https://cdn.21st.dev/rmahammad/filmstrip-scrub/default/video.1790072120543-2563d96d-37c9-4216-98b8-e9d6eb6d17c1.mp4","author":"rmahammad","authorImage":"https://img.clerk.com/eyJ0eXBlIjoicHJveHkiLCJzcmMiOiJodHRwczovL2ltYWdlcy5jbGVyay5kZXYvb2F1dGhfZ2l0aHViL2ltZ18zSERlNkNvTWlueXdDREZuVldPMEgxVDVNS1kifQ","installCommand":"npx shadcn@latest add \"https://21st.dev/r/rmahammad/filmstrip-scrub?api_key=$API_KEY_21ST\"","url":"https://21st.dev/@rmahammad/components/filmstrip-scrub"},{"type":"component","id":38970,"name":"Dither Scan","description":"An image that starts as a 1-bit ordered dither. A diagonal scan line sweeps it a set number of times, and each pass sharpens the cells and brings back tone and color until the source is clean.","previewUrl":"https://cdn.21st.dev/radiumcoders/dither-scan/default/preview.1792249943839-dbf523ba-1712-4977-a3ec-8510d6e0e031.png","videoUrl":"https://cdn.21st.dev/radiumcoders/dither-scan/default/video.1793392968887-194727a9-2dec-44a9-bb5a-7cae3e211e35.mp4","author":"radiumcoders","authorImage":"https://vucvdpamtrjkzmubwlts.supabase.co/storage/v1/object/public/users/user_36kD1scOExJb89UoQCZAl3Z0xi7/avatar.png","installCommand":"npx shadcn@latest add \"https://21st.dev/r/radiumcoders/dither-scan?api_key=$API_KEY_21ST\"","url":"https://21st.dev/@radiumcoders/components/dither-scan"},{"type":"component","id":27190,"name":"Stack Spread","description":"Interactive scroll-driven linear to spatial stack spread animation","previewUrl":"https://cdn.21st.dev/user_332oxzW8MyPod4IDIdKq9rbPYuk/stack-spread/default/preview.1789396099152.png","videoUrl":"https://cdn.21st.dev/user_332oxzW8MyPod4IDIdKq9rbPYuk/stack-spread/default/video.1789396128042.mp4","author":"daiwiikharihar","authorImage":"https://vucvdpamtrjkzmubwlts.supabase.co/storage/v1/object/public/users/user_332oxzW8MyPod4IDIdKq9rbPYuk/avatar.jpeg","installCommand":"npx shadcn@latest add \"https://21st.dev/r/daiwiikharihar/stack-spread?api_key=$API_KEY_21ST\"","url":"https://21st.dev/@daiwiikharihar/components/stack-spread"},{"type":"component","id":39149,"name":"Scatter Rewind","description":"An animated headline that disintegrates into scattering dust particles and can rewind itself back together, triggered by hover, click, scroll, or entering the viewport.","previewUrl":"https://cdn.21st.dev/user_2tkbBPFWYn8YMjZNHwgIuP3yzvd/scatter-rewind/default/preview.1792488342394.webp","videoUrl":"https://cdn.21st.dev/user_2tkbBPFWYn8YMjZNHwgIuP3yzvd/scatter-rewind/default/video.1792488337746.mp4","author":"isaiahbjork","authorImage":"https://img.clerk.com/eyJ0eXBlIjoicHJveHkiLCJzcmMiOiJodHRwczovL2ltYWdlcy5jbGVyay5kZXYvb2F1dGhfZ2l0aHViL2ltZ18ydGtiQlBjalhzMzl1eGNmR2h3c3VTWE1VU1YifQ","installCommand":"npx shadcn@latest add \"https://21st.dev/r/isaiahbjork/scatter-rewind?api_key=$API_KEY_21ST\"","url":"https://21st.dev/@isaiahbjork/components/scatter-rewind"},{"type":"component","id":17863,"name":"Warp","description":"Animated color fields warped by noise and swirls over base patterns (checks, stripes, or split edge). Blends many colors with adjustable distribution, softness, distortion, and swirl. Great for fluid, smoky, or marbled effects.","previewUrl":"https://cdn.21st.dev/user_papershaders/warp/default/preview.1785931186718.png","videoUrl":"https://cdn.21st.dev/user_papershaders/warp/default/video.1785931209227.mp4","author":"paper-design","authorImage":"https://avatars.githubusercontent.com/u/178361271?s=48&v=4","installCommand":"npx shadcn@latest add \"https://21st.dev/r/paper-design/warp?api_key=$API_KEY_21ST\"","url":"https://21st.dev/@paper-design/components/warp"},{"type":"component","id":33251,"name":"Hero Dipole Field","description":"A full-bleed hero section where a canvas field of iron-filing strokes solved from a two-pole dipole field forms the headline's letters as the cursor approaches, with the CTA acting as a fixed magnetic pole that bends the field on hover.","previewUrl":"https://cdn.21st.dev/nikolas-sapa/hero-dipole-field/default/preview.1790525376273-8a01c396-dd45-4ac2-a825-c242fb9a1e61.png","videoUrl":"https://cdn.21st.dev/nikolas-sapa/hero-dipole-field/default/video.1790525376273-8a01c396-dd45-4ac2-a825-c242fb9a1e61.mp4","author":"nikolas-sapa","authorImage":"https://github.com/nikolas-sapa.png","installCommand":"npx shadcn@latest add \"https://21st.dev/r/nikolas-sapa/hero-dipole-field?api_key=$API_KEY_21ST\"","url":"https://21st.dev/@nikolas-sapa/components/hero-dipole-field"},{"type":"component","id":28347,"name":"Animated Border Beam","description":"Animated border beam effect for cards and surfaces — rotate, pulse-inner, pulse-outside, or trace styles, with per-color-variant and light/dark tuning.","previewUrl":"https://cdn.21st.dev/hyperiux/border-beam/default/preview.1789969877057-2798d573-a610-405f-a997-036e8d6294c4.jpg","videoUrl":"https://cdn.21st.dev/user_3IlVIzEF1oziaTRKTKA3Qak2f5C/border-beam/default/video.1789970851523.mp4","author":"hyperiux","authorImage":"https://vucvdpamtrjkzmubwlts.supabase.co/storage/v1/object/public/users/user_3IlVIzEF1oziaTRKTKA3Qak2f5C/avatar.png","installCommand":"npx shadcn@latest add \"https://21st.dev/r/hyperiux/border-beam?api_key=$API_KEY_21ST\"","url":"https://21st.dev/@hyperiux/components/border-beam"},{"type":"component","id":25799,"name":"Radiance Cascades","description":"Draw light with the pointer and watch it bounce: a jump-flooded distance field feeds six radiance cascades — base 4, geometric intervals, linear RGBA16F — merged top-down with visibility alpha into 2D global illumination.","previewUrl":"https://cdn.21st.dev/user_vendor_vgpu/radiance-cascades/default/preview.1788189613834.png","videoUrl":"https://cdn.21st.dev/user_vendor_vgpu/radiance-cascades/default/video.1788189644094.mp4","author":"vgpu","authorImage":"https://img.logo.dev/vercel.com?token=live_6a1a28fd-6420-4492-aeb0-b297461d9de2&size=128&retina=true&format=png","installCommand":"npx shadcn@latest add \"https://21st.dev/r/vgpu/radiance-cascades?api_key=$API_KEY_21ST\"","url":"https://21st.dev/@vgpu/components/radiance-cascades"},{"type":"component","id":27200,"name":"Grid Pulse","description":"A hairline grid that lights up in a spectrum wherever the pointer passes, then fades a moment later.","previewUrl":"https://cdn.21st.dev/user_3HeqhvjsOOzoradymfkXsFo40dT/grid-pulse/default/preview.1789478834779.webp","videoUrl":"https://cdn.21st.dev/user_3HeqhvjsOOzoradymfkXsFo40dT/grid-pulse/default/video.1789478817605.mp4","author":"carolinaraulino","authorImage":"https://vucv