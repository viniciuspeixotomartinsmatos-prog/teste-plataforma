{"name":"Illos Stats Card","framework":"react","files":[{"path":"components/ui/illos-stats-card.tsx","content":"\"use client\";\n\n// KPI card with a range switch (7, 30 or 90 days), the change against the period before, and a bar chart you can\n// point at or step through with the arrow keys.\n// The illustration is Requests chart (Interface) from Illos (https://illos.dev).\n// It loops while it is on screen, pauses off screen, and stays still for prefers-reduced-motion.\n// Icons are from the Hugeicons free set (MIT).\n//\n// License\n// The component code in this file (layout, props, play logic) is free to use, change and share under the MIT license.\n// The illustration inside it (the SVG markup and its animation) is not covered by MIT. It belongs to Illos and is\n// licensed under the Illos free license, https://illos.dev/license: you can use it in personal and commercial work,\n// including client projects, with no credit needed, and you may modify it. Not allowed: redistributing or selling it\n// as an asset (packs, illustration or icon sites, or other libraries), or using it to build a competing illustration\n// library.\nimport { memo, useEffect, useId, useRef, useState, type CSSProperties, type ReactNode } from \"react\";\n\nconst cx = (...c: (string | false | undefined)[]) => c.filter(Boolean).join(\" \");\n\nconst CHART_SVG = `<svg class=\"if-requests-chart\" xmlns=\"http://www.w3.org/2000/svg\" width=\"720\" height=\"460\" viewBox=\"0 0 720 460\" fill=\"none\" stroke=\"#d6d6d9\" role=\"img\" aria-labelledby=\"if-requests-chart-t\" aria-describedby=\"if-requests-chart-d\">\n<title id=\"if-requests-chart-t\">Requests chart</title>\n<desc id=\"if-requests-chart-d\">A bar chart of requests per day for a week. A cursor picks Tuesday, then Thursday: Thursday's bar turns teal and its value, 3,204, appears above it.</desc>\n<style>@scope (svg.if-requests-chart) {\n:scope{--_ground:#ffffff;--_ink:#2a2a2a;--_accent:#1daf9c;--_if-surface:#f7f7f8;--_if-raised:#ffff