rvalho: selos presos ao frasco -->\r\n      <div class=\"act act--2\">\r\n        <p class=\"act__label mono\">II — 04:10 · ORVALHO</p>\r\n        <p class=\"act__text\" data-mask>\r\n          <span class=\"line\"><span>A pedra molhada,</span></span>\r\n          <span class=\"line\"><span>o ar frio,</span></span>\r\n          <span class=\"line\"><span>a rua sem ninguém.</span></span>\r\n        </p>\r\n      </div>\r\n      <ul class=\"seals\" aria-label=\"Notas do Sereno Nº 7\">\r\n        <li class=\"seal\" data-seal=\"tampa\"><span class=\"seal__ring\">1</span><span class=\"seal__line\"></span><span class=\"seal__label mono\">Bergamota<span class=\"seal__role\"> · topo</span></span></li>\r\n        <li class=\"seal\" data-seal=\"colar\"><span class=\"seal__ring\">2</span><span class=\"seal__line\"></span><span class=\"seal__label mono\">Flor de laranjeira<span class=\"seal__role\"> · coração</span></span></li>\r\n        <li class=\"seal\" data-seal=\"base\"><span class=\"seal__ring\">3</span><span class=\"seal__line\"></span><span class=\"seal__label mono\">Vetiver<span class=\"seal__role\"> · fundo</span></span></li>\r\n      </ul>\r\n\r\n      <!-- III o perfume -->\r\n      <div class=\"act act--3\">\r\n        <p class=\"act__label mono\">III — 05:12 · O PERFUME</p>\r\n        <p class=\"act__text act__text--big\" data-mask>\r\n          <span class=\"line\"><span>A gente guardou</span></span>\r\n          <span class=\"line\"><span>essa hora</span></span>\r\n          <span class=\"line\"><span>num frasco.</span></span>\r\n        </p>\r\n      </div>\r\n\r\n      <!-- HUD -->\r\n      <ol class=\"rail mono\" aria-hidden=\"true\">\r\n        <li class=\"rail__item is-on\">MADRUGADA</li>\r\n        <li class=\"rail__item\">ORVALHO</li>\r\n        <li class=\"rail__item\">O PERFUME</li>\r\n        <span class=\"rail__fill\"></span>\r\n      </ol>\r\n      <div class=\"specline mono\" aria-label=\"Especificações\">\r\n        <span class=\"specline__rule\" 