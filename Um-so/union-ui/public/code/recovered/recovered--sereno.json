allout callout--4 callout--left\"><span class=\"callout__line\"></span><p class=\"mono\"><b>04</b> <span data-scramble>ESSÊNCIA</span></p><p>50 ml · 22% de óleo</p></li>\r\n        </ol>\r\n        </div>\r\n      </div>\r\n    </section>\r\n\r\n    <!-- 04 Na pele: dez horas em três atos (pin) -->\r\n    <section class=\"skin\" id=\"na-pele\">\r\n      <div class=\"skin__stage\">\r\n        <figure class=\"skin__photos\" aria-hidden=\"true\">\r\n          <img class=\"skin__img is-on\" src=\"/previews/recovered/demos/sereno/img/bergamota.webp\" alt=\"\" width=\"900\" height=\"1350\" />\r\n          <img class=\"skin__img\" src=\"/previews/recovered/demos/sereno/img/flor.webp\" alt=\"\" width=\"900\" height=\"1350\" loading=\"lazy\" />\r\n          <img class=\"skin__img\" src=\"/previews/recovered/demos/sereno/img/vetiver.webp\" alt=\"\" width=\"900\" height=\"1350\" loading=\"lazy\" />\r\n        </figure>\r\n        <div class=\"skin__text\">\r\n          <p class=\"label mono\">04 — NA PELE</p>\r\n          <h2 class=\"display\">DEZ HORAS,<br />TRÊS ATOS.</h2>\r\n          <div class=\"timeline mono\" aria-hidden=\"true\">\r\n            <div class=\"timeline__ends\"><span>0 MIN</span><span class=\"timeline__now\">0 MIN</span><span>10 H</span></div>\r\n            <div class=\"timeline__track\"><span class=\"timeline__fill\"></span></div>\r\n            <div class=\"timeline__ticks\"></div>\r\n          </div>\r\n          <ol class=\"notes\">\r\n            <li class=\"note is-on\">\r\n              <span class=\"note__t mono\">0 min</span>\r\n              <div><h3 class=\"note__name\">Bergamota</h3><p class=\"note__where mono\" data-scramble>Topo · Calábria</p></div>\r\n              <p class=\"note__desc\">Fria e verde. A primeira respiração da noite.</p>\r\n            </li>\r\n            <li class=\"note\">\r\n              <span class=\"note__t mono\">2 h</span>\r\n              <div><h3 class=\"note__name\">Flor de laranjeira</h3><p class=\"note__where mono\" data-scramble>Coração · Matão, SP</p></div>\r\n              <p class=\"note__desc\">Branca e quieta, como a casa dormindo.</p>\r\n            </li>\r\n            <li class=\"note\">\r\n              <span class=\"note__t mono\">6 h</span>\r\n              <div><h3 class=\"note__name\">Vetiver</h3><p class=\"note__where mono\" data-scramble>Fundo · Haiti</p></div>\r\n              <p class=\"note__desc\">Terra molhada até o dia nascer.</p>\r\n            </li>\r\n          </ol>\r\n        </div>\r\n      </div>\r\n    </section>\r\n\r\n    <!-- 05 Ritual -->\r\n    <section class=\"ritual\" id=\"ritual\">\r\n      <figure class=\"ritual__photo\">\r\n        <img src=\"/previews/recovered/demos/sereno/img/ritual.webp\" alt=\"Pulso perto do pescoço, com gotas de perfume na pele, sob luz azul\" width=\"1600\" height=\"1067\" loading=\"lazy\" />\r\n        <span class=\"pin\" data-x=\"0.565\" data-y=\"0.47\">01</span>\r\n        <span class=\"pin\" data-x=\"0.75\" data-y=\"0.19\">02</span>\r\n        <span class=\"pin\" data-x=\"0.88\" data-y=\"0.59\">03</span>\r\n      </figure>\r\n      <div class=\"ritual__text\">\r\n        <p class=\"label mono\">05 — RITUAL</p>\r\n        <h2 class=\"display\">QUATRO BORRIFOS.<br />ANTES DE SAIR.</h2>\r\n        <ol class=\"steps\">\r\n          <li class=\"step\"><span class=\"mono\">01</span><div><h3>Pulso</h3><p>Dois borrifos. Sem esfregar.</p></div></li>\r\n          <li class=\"step\"><span class=\"mono\">02</span><div><h3>Pescoço</h3><p>Um, atrás da orelha.</p></div></li>\r\n          <li class=\"step\"><span class=\"mono\">03</span><div><h3>Gola</h3><p>Um, a vinte centímetros do tecido.</p></div></li>\r\n        </ol>\r\n      </div>\r\n    </section>\r\n\r\n    <!-- 06 Fecho: tabela de specs e compra -->\r\n    <section class=\"close\" id=\"comprar\">\r\n      <img class=\"close__bottle\" src=\"/previews/recovered/demos/sereno/img/fecho.webp\" alt=\"\" aria-hidden=\"true\" width=\"1600\" height=\"900\" loading=\"lazy\" />\r\n      <div class=\"close__inner\">\r\n        <h2 class=\"display close__title\" data-mask>\r\n          <span class=\"line\"><span>CINQUENTA MILILITROS</span></span>\r\n          <span class=\"line\"><span>DE MADRUGADA.</span></span>\r\n        </h2>\r\n        <div class=\"close__spacer\" aria-hidden=\"true\"></div>\r\n        <table class=\"specs\">\r\n          <caption class=\"sr-only\">Especificações do Sereno Nº 7</caption>\r\n          <tbody>\r\n            <tr><th scope=\"row\">Frasco</th><td>Vidro soprado, Campo Largo, PR</td><td>50 ml</td></tr>\r\n            <tr><th scope=\"row\">Concentração</th><td>Eau de parfum</td><td>22%</td></tr>\r\n            <tr><th scope=\"row\">Duração</th><td>Na pele</td><td>8–10 h</td></tr>\r\n            <tr><th scope=\"row\">Tampa</th><td>Cristal lapidado e latão</td><td>18 faces</td></tr>\r\n            <tr><th scope=\"row\">Lote</th><td>Numerado à mão</td><td>300 frascos</td></tr>\r\n          </tbody>\r\n        </table>\r\n        <a class=\"buy\" href=\"#comprar\">Comprar Sereno Nº 7 — R$ 590 <span aria-hidden=\"true\">→</span></a>\r\n        <p class=\"close__note mono\">Lote 01 · frete grátis para todo o Brasil · parcele em até 6×</p>\r\n      </div>\r\n    </section>\r\n  </main>\r\n\r\n  <footer class=\"footer mono\">\r\n    <p>SERENO PERFUMARIA LTDA · CNPJ 41.872.330/0001-07</p>\r\n    <p class=\"footer__links\"><a href=\"#\">Instagram</a> · <a href=\"#\">Trocas em 7 dias</a> · <span>Envio para todo o Brasil</span></p>\r\n    <p class=\"footer__n\">06 / 06</p>\r\n  </footer>\r\n</body>\r\n</html>\r\n"},{"path":"RECONSTRUCTION.md","content":"# Sereno — prompt reconstruído\n\nEste prompt foi reconstruído a partir da demonstração pública e da descrição do item. Não é o prompt original do servidor.\n\nCrie uma landing page completa com esta direção: Perfume autoral noturno: o vídeo do frasco avança com o scroll e conta a madrugada em três atos, de 02:47 a 05:12.\n\nReferência executável ou gravada: /previews/recovered/demos/sereno/index.html.\nPreserve o comportamento da demonstração local: composição, tipografia, materiais, animações e respostas ao ponteiro, clique, teclado e rolagem quando presentes.\n\nCategoria: perfumaria. Tags: perfumaria, cosmetico, escuro, video-scroll, frames-canvas, vista-explodida, scroll, gsap, lenis, tipografia-larga. Tom: escuro. Proporção de apresentação: 16/10.\n\nImplemente HTML semântico e componentes React isolados, estilos responsivos para celular, tablet e desktop, foco visível, rótulos acessíveis e prefers-reduced-motion. Preserve os shaders/WebGL/canvas presentes na referência; não substitua os efeitos por imagem estática. Use os recursos locais do pacote. Separe conteúdo configurável e valores de animação. Não invente funcionamento de serviços externos, pagamentos ou autenticação: conecte essas partes somente a backends reais configurados no projeto de destino.\n\nO pacote pode conter JavaScript compilado recuperado, não o TSX original. Compare o resultado com a prévia em movimento, inclusive estados de hover, abertura e fechamento, arraste ou navegação que ela apresentar.\n"}]}