{"name":"NORTH","framework":"html","sourceUrl":"https://21st.dev/community/themes/north-1793796311382","license":"Preserve original source terms and notices.","files":[{"path":"theme.css","content":"/* NORTH theme — dark-first studio brand */\n:root {\n  --background: 0 0% 98%;\n  --foreground: 240 5% 4%;\n  --card: 240 5% 96%;\n  --card-foreground: 240 5% 4%;\n  --popover: 0 0% 98%;\n  --popover-foreground: 240 5% 4%;\n  --primary: 75 90% 61%;\n  --primary-foreground: 240 5% 4%;\n  --secondary: 0 0% 96%;\n  --secondary-foreground: 240 5% 4%;\n  --muted: 0 0% 96%;\n  --muted-foreground: 240 4% 46%;\n  --accent: 75 90% 61%;\n  --accent-foreground: 240 5% 4%;\n  --destructive: 0 84% 60%;\n  --destructive-foreground: 0 0% 98%;\n  --border: 0 0% 90%;\n  --input: 0 0% 90%;\n  --ring: 75 90% 61%;\n  --chart-1: 75 90% 61%;\n  --chart-2: 160 40% 40%;\n  --chart-3: 220 15% 40%;\n  --chart-4: 40 80% 55%;\n  --chart-5: 0 0% 45%;\n  --radius: 0.625rem;\n  --sidebar: 240 5% 96%;\n  --sidebar-foreground: 240 5% 4%;\n  --sidebar-primary: 75 90% 61%;\n  --sidebar-primary-foreground: 240 5% 4%;\n  --sidebar-accent: 0 0% 96%;\n  --sidebar-accent-foreground: 240 5% 4%;\n  --sidebar-border: 0 0% 90%;\n  --sidebar-ring: 75 90% 61%;\n}\n.dark {\n  --background: 0 0% 2%;\n  --foreground: 0 0% 98%;\n  --card: 240 3% 6%;\n  --card-foreground: 0 0% 98%;\n  --popover: 240 5% 4%;\n  --popover-foreground: 0 0% 98%;\n  --primary: 75 90% 61%;\n  --primary-foreground: 240 5% 4%;\n  --secondary: 240 5% 8%;\n  --secondary-foreground: 0 0% 98%;\n  --muted: 240 5% 8%;\n  --muted-foreground: 0 0% 64%;\n  --accent: 75 90% 61%;\n  --accent-foreground: 240 5% 4%;\n  --destructive: 0 72% 51%;\n  --destructive-foreground: 0 0% 98%;\n  --border: 0 0% 100%;\n  --input: 0 0% 100%;\n  --ring: 75 90% 61%;\n  --chart-1: 75 90% 61%;\n  --chart-2: 160 45% 45%;\n  --chart-3: 220 12% 55%;\n  --chart-4: 40 85% 55%;\n  --chart-5: 0 0% 55%;\n  --radius: 0.625rem;\n  --sidebar: 240 5% 4%;\n  --sidebar-foreground: 0 0% 98%;\n  --sidebar-primary: 75 90% 61%;\n  --sidebar-primary-foreground: 240 5% 4%;\n  --sidebar-accent: 240 5% 8%;\n  --sidebar-accent-foreground: 0 0% 98%;\n  --sidebar-border: 0 0% 100%;\n  --sidebar-ring: 75 90% 61%;\n}\n"},{"path":"preview.html","content":"<!doctype html><html lang=\"pt-BR\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>NORTH</title><style>/* NORTH theme — dark-first studio brand */\n:root {\n  --background: hsl(0 0% 98%);\n  --foreground: hsl(240 5% 4%);\n  --card: hsl(240 5% 96%);\n  --card-foreground: hsl(240 5% 4%);\n  --popover: hsl(0 0% 98%);\n  --popover-foreground: hsl(240 5% 4%);\n  --primary: hsl(75 90% 61%);\n  --primary-foreground: hsl(240 5% 4%);\n  --secondary: hsl(0 0% 96%);\n  --secondary-foreground: hsl(240 5% 4%);\n  --muted: hsl(0 0% 96%);\n  --muted-foreground: hsl(240 4% 46%);\n  --accent: hsl(75 90% 61%);\n  --accent-foreground: hsl(240 5% 4%);\n  --destructive: hsl(0 84% 60%);\n  --destructive-foreground: hsl(0 0% 98%);\n  --border: hsl(0 0% 90%);\n  --input: hsl(0 0% 90%);\n  --ring: hsl(75 90% 61%);\n  --chart-1: hsl(75 90% 61%);\n  --chart-2: hsl(160 40% 40%);\n  --chart-3: hsl(220 15% 40%);\n  --chart-4: hsl(40 80% 55%);\n  --chart-5: hsl(0 0% 45%);\n  --radius: 0.625rem;\n  --sidebar: hsl(240 5% 96%);\n  --sidebar-foreground: hsl(240 5% 4%);\n  --sidebar-primary: hsl(75 90% 61%);\n  --sidebar-primary-foreground: hsl(240 5% 4%);\n  --sidebar-accent: hsl(0 0% 96%);\n  --sidebar-accent-foreground: hsl(240 5% 4%);\n  --sidebar-border: hsl(0 0% 90%);\n  --sidebar-ring: hsl(75 90% 61%);\n}\n.dark {\n  --background: hsl(0 0% 2%);\n  --foreground: hsl(0 0% 98%);\n  --card: hsl(240 3% 6%);\n  --card-foreground: hsl(0 0% 98%);\n  --popover: hsl(240 5% 4%);\n  --popover-foreground: hsl(0 0% 98%);\n  --primary: hsl(75 90% 61%);\n  --primary-foreground: hsl(240 5% 4%);\n  --secondary: hsl(240 5% 8%);\n  --secondary-foreground: hsl(0 0% 98%);\n  --muted: hsl(240 5% 8%);\n  --muted-foreground: hsl(0 0% 64%);\n  --accent: hsl(75 90% 61%);\n  --accent-foreground: hsl(240 5% 4%);\n  --destructive: hsl(0 72% 51%);\n  --destructive-foreground: hsl(0 0% 98%);\n  --border: hsl(0 0% 100%);\n  --input: hsl(0 0% 100%);\n  --ring: hsl(75 90% 61%);\n  --chart-1: hsl(75 90% 61%);\n  --chart-2: hsl(160 45% 45%);\n  --chart-3: hsl(220 12% 55%);\n  --chart-4: hsl(40 85% 55%);\n  --chart-5: hsl(0 0% 55%);\n  --radius: 0.625rem;\n  --sidebar: hsl(240 5% 4%);\n  --sidebar-foreground: hsl(0 0% 98%);\n  --sidebar-primary: hsl(75 90% 61%);\n  --sidebar-primary-foreground: hsl(240 5% 4%);\n  --sidebar-accent: hsl(240 5% 8%);\n  --sidebar-accent-foreground: hsl(0 0% 98%);\n  --sidebar-border: hsl(0 0% 100%);\n  --sidebar-ring: hsl(75 90% 61%);\n}\n</style><style>*{box-sizing:border-box}body{margin:0;background:var(--background);color:var(--foreground);font-family:var(--font-sans,system-ui);padding:clamp(18px,5vw,64px)}main{max-width:920px;margin:auto}header{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:38px}h1{font-size:38px;margin:8px 0;letter-spacing:-.04em}p{line-height:1.6}small{color:var(--muted-foreground)}section{border:1px solid var(--border);border-radius:var(--radius,12px);background:var(--card);color:var(--card-foreground);padding:26px;min-width:0}.grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}.swatches{display:flex;gap:10px;margin:24px 0}.swatches i{width:48px;height:48px;border-radius:var(--radius,8px);border:1px solid var(--border)}button,input,select{font:inherit;border-radius:var(--radius,8px);padding:12px 16px;border:1px solid var(--border)}button{cursor:pointer;background:var(--primary);color:var(--primary-foreground)}button.secondary{background:var(--secondary);color:var(--secondary-foreground)}button:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid var(--ring);outline-offset:3px}label{display:flex;flex-direction:column;gap:8px;margin:20px 0}input,select{width:100%;background:var(--background);color:var(--foreground)}.actions{display:flex;gap:10px;flex-wrap:wrap}output{display:block;margin-top:15px;color:var(--muted-foreground)}@media(max-width:600px){.grid{grid-template-columns:1fr}h1{font-size:28px}header{align-items:flex-start}}</style></head><body><main><header><div><small>CORES E TIPOGRAFIA</small><h1>NORTH</h1><p>Experimente os tokens deste tema.</p></div><button class=\"secondary\" id=\"theme\" aria-pressed=\"false\">Alternar tema</button></header><div class=\"grid\"><section><h2>Seu próximo projeto</h2><p>Uma paleta aplicada a elementos reais da interface.</p><div class=\"swatches\" aria-label=\"Cores do tema\"><i style=\"background:var(--primary)\"></i><i style=\"background:var(--secondary)\"></i><i style=\"background:var(--accent)\"></i><i style=\"background:var(--destructive)\"></i></div><label>Nome do projeto<input placeholder=\"Minha próxima ideia\"></label><label>Categoria<select><option>Aplicativo</option><option>Portfólio</option><option>Loja</option></select></label><div class=\"actions\"><button id=\"save\">Salvar projeto</button><button class=\"secondary\" id=\"reset\">Limpar</button></div><output id=\"status\" aria-live=\"polite\"></output></section><section><h2>Configurações</h2><p>Ajuste as opções e confira o contraste da paleta.</p><label>Notificações<input type=\"checkbox\" checked></label><label>Intensidade<input type=\"range\" min=\"0\" max=\"100\" value=\"65\"></label><p>Texto de apoio e estados de foco usam os tokens originais.</p></section></div></main><script>document.querySelector('#theme').onclick=e=>{const dark=document.documentElement.classList.toggle('dark');e.currentTarget.setAttribute('aria-pressed',String(dark))};document.querySelector('#save').onclick=()=>document.querySelector('#status').textContent='Projeto salvo nesta demonstração.';document.querySelector('#reset').onclick=()=>{document.querySelector('input').value='';document.querySelector('#status').textContent='Campos limpos.'};</script></body></html>"}]}