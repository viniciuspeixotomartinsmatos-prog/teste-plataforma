    <!-- What iOS paints behind the status bar and toolbar. This is the landing as
         it actually renders — its #0d0d0f under the grain overlay — not the value
         --bg is set to, so the bands never draw an edge against the content under
         them. See --edge in styles.css. Also the first paint for a cold
         visit; App.tsx keeps it in sync from there. -->
    <meta name="theme-color" content="#1a1a1c" />
