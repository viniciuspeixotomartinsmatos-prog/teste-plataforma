NODE_ENV=production
APP_ORIGIN=https://teste-plataforma-delta.vercel.app
PORT=4173
# Segredo privado; nunca coloque em variáveis VITE_.
BETTER_AUTH_SECRET=
SMTP_URL=
MAIL_FROM=nitido <conta@seu-dominio.example>
# Produção Vercel usa Supabase Auth + Postgres. Nunca prefixe chaves privadas com VITE_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Pagamentos desativados por decisão do usuário.
BILLING_ENABLED=false
# Paddle is independent from the cancelled Stripe integration. Defaults OFF.
PADDLE_BILLING_ENABLED=false
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRODUCT_ID=
PADDLE_PRICE_MONTHLY=
PADDLE_PRICE_QUARTERLY=
PADDLE_PRICE_YEARLY=
# Server only: used by atomic billing RPCs. Never use a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
# Optional reviewed foreign prices, e.g. array entries with planId,currency,amount,priceId.
# No USD/EUR amounts are approved yet. Keep this empty until amounts are decided.
PADDLE_REGIONAL_PRICES_JSON=[]
PADDLE_LIVE_APPROVED=false
PADDLE_LICENSE_APPROVED=false

# Privacy deletion stays off until remote schema/session/billing checks pass.
ACCOUNT_DELETION_READY=false
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_DOCUMENT=
LEGAL_ENTITY_ADDRESS=
PRIVACY_CONTACT_EMAIL=
SUPPORT_EMAIL=
LEGAL_REVIEW_APPROVED=false
# Optional operator-only encrypted backup; never use VITE_ for these settings.
SUPABASE_DB_URL=
NITIDO_BACKUP_DIRECTORY=
NITIDO_BACKUP_KEY_BASE64=

# Optional server-only Google PageSpeed key; anonymous quota may be unavailable.
# Use only an existing approved free quota. Never prefix with VITE_.
GOOGLE_PAGESPEED_API_KEY=
